{
  "name": "roundhouse",
  "version": "0.1.0",
  "private": true,
  "description": "Generic Notion-to-executor orchestration for Roundhouse",
  "type": "module",
  "bin": {
    "roundhouse": "./src/cli.js"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.js",
    "test:unit": "node --test test/item.test.js test/config.test.js test/intake.test.js test/codex-executor.test.js test/claude-executor.test.js test/workflow-unit.test.js",
