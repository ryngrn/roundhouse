{
  "name": "roundhouse",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first control plane for policy-controlled autonomous work",
  "type": "module",
  "bin": {
    "roundhouse": "./src/cli.js"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "start": "node src/server/app-server.js",
    "mcp": "node src/mcp/http-server.js",
    "test": "node --test test/*.test.js",
    "test:unit": "node --test test/item.test.js test/config.test.js test/intake.test.js test/codex-executor.test.js test/workflow-unit.test.js",
    "test:e2e": "node --test test/workflow-e2e.test.js test/acceptance.test.js",
    "acceptance": "node --test test/workflow-e2e.test.js test/acceptance.test.js",
    "acceptance:live": "node --test test/acceptance-live.test.js",
    "demo": "node scripts/demo.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "ipaddr.js": "^2.5.0",
    "standardwebhooks": "^1.1.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
